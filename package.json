{
  "name": "controlmesh-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "generate:protocol": "node packages/controlmesh-protocol/scripts/generate.mjs",
    "generate:protocol:python": "uv run python scripts/generate_protocol.py",
    "generate:all-protocol": "pnpm generate:protocol && pnpm generate:protocol:python",
    "check:protocol": "pnpm generate:all-protocol && git diff --exit-code packages/controlmesh-protocol/src/generated packages/controlmesh-protocol/src/validators controlmesh/protocol/generated",
    "generate:lifecycle-golden": "uv run python scripts/generate_task_lifecycle_goldens.py",
    "check:lifecycle-golden": "uv run python scripts/generate_task_lifecycle_goldens.py --check",
    "generate:lifecycle-rollback-gate": "bun packages/controlmesh-runtime-facade/scripts/check-lifecycle-parity.ts --write",
    "check:lifecycle-parity": "bun packages/controlmesh-runtime-facade/scripts/check-lifecycle-parity.ts",
    "test:golden": "pnpm check:lifecycle-golden && pnpm --filter @controlmesh/runtime-facade typecheck && pnpm --filter @controlmesh/runtime-facade test:parity && pnpm check:lifecycle-parity && uv run python -m pytest tests/protocol tests/golden -q",
    "test:sdk": "pnpm --filter @controlmesh/sdk test:smoke"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
