{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlmesh.dev/controlmesh/v1/device-response.schema.json",
  "title": "DeviceResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "const": "controlmesh.device_response.v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "ok": {
      "type": "boolean"
    },
    "data": {},
    "error": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,96}$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    }
  ]
}
