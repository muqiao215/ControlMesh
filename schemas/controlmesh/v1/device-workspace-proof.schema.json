{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlmesh.dev/controlmesh/v1/device-workspace-proof.schema.json",
  "title": "DeviceWorkspaceProof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_digest",
    "proposal_digest",
    "changed_count"
  ],
  "properties": {
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changed_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "specmesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_digest",
        "status",
        "closeout_verified"
      ],
      "properties": {
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "pass"
        },
        "closeout_verified": {
          "const": false
        }
      }
    }
  }
}
