{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlmesh.dev/controlmesh/v1/device-completion-proof.schema.json",
  "title": "DeviceCompletionProof",
  "type": "object", "additionalProperties": false,
  "required": ["requirements_digest", "sha256"],
  "properties": {
    "requirements_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
