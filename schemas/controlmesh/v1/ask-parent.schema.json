{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlmesh.dev/controlmesh/v1/ask-parent.schema.json",
  "title": "AskParentRequest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "request_id", "task_id", "question", "created_at"],
  "properties": {
    "schema_version": { "const": "controlmesh.ask_parent_request.v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "tool_use_id": { "type": "string" },
    "parent_agent": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "routing": { "type": "object", "additionalProperties": true }
  }
}
