{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.controlmesh.dev/controlmesh/v1/native-agent-scope.schema.json",
  "title": "NativeAgentScope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "episode_id",
    "fence",
    "peer_tasks",
    "parent_task",
    "client_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "controlmesh.native_agent_scope.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "peer_tasks": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"
      }
    },
    "parent_task": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,191}$"
    },
    "client_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
