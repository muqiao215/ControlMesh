{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecMeshResult",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "specmesh.port.v1-draft"
      ]
    },
    "observed_head": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "pass",
        "blocked",
        "unknown"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "code",
          "severity",
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "authority": {
            "enum": [
              "asserted_candidate",
              "derived"
            ]
          },
          "tracked": {
            "type": "boolean"
          },
          "modified": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "authority",
          "tracked",
          "modified"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    }
  },
  "required": [
    "contract_version",
    "observed_head",
    "status",
    "findings",
    "references"
  ],
  "additionalProperties": false
}
